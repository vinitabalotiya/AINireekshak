# AiNireekshak Environment Configuration
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+psycopg://ainireekshak:ainireekshak_dev@localhost:5432/ainireekshak
DATABASE_URL_SQLITE=sqlite+aiosqlite:///./ainireekshak.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Authentication
JWT_SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Providers (optional - app runs in demo mode without these)
GEMINI_API_KEY=
OPENAI_API_KEY=

# LiveKit (optional - app runs without live judging if not configured)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Storage
STORAGE_PATH=./uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_LIVEKIT_URL=

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=http://localhost:3000
